# Copy to .env and fill in. NEVER commit .env. Names mirror SECRETS.txt (OpenBao).
# Topology (hosts/DB URLs/ports) lives in docker-compose.yml; only secrets go here.
POSTGRES_USER=itasset_app
POSTGRES_PASSWORD=change-me

# Shared HS256 key — user-auth signs, assetservice validates. Must match, >= 32 bytes.
JWT_SECRET=change-me-at-least-32-bytes-long-random
