# Copy this file to application.yaml and fill in your real DB password.
# application.yaml is gitignored so credentials never reach the repo.
# Day 32: asset-service is now a microservice — registers in Eureka, pulls config from config-server.
spring:
  application:
    name: asset-service              # registers in Eureka as ASSET-SERVICE; config-server serves config/asset-service.yml
  config:
    import: "configserver:${CONFIG_SERVER_URL:http://localhost:8888}"
  cloud:
    config:
      fail-fast: true                # don't boot half-configured
      retry:
        max-attempts: 6
  data:
    web:
      pageable:
        default-page-size: 20   # used when the request omits ?size
        max-page-size: 100      # user asking ?size=1000 gets clamped to 100
  # DB-per-service: asset-service owns assetdb (own Postgres container; DB_PORT lets it point at a non-default host port)
  datasource:
    url: jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/assetdb
    username: ${DB_USER:postgres}
    password: ${DB_PASSWORD:CHANGE_ME}
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true

# server.port, eureka, and jwt.* come from config-server (config/asset-service.yml + shared application.yml)
